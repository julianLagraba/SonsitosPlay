# TMDB API Key - Obtén una en https://www.themoviedb.org/settings/api
TMDB_API_KEY=tu_api_key_aqui

# Login de la app (opcional: si no se definen, se usan las credenciales por defecto)
AUTH_USERNAME=tu_usuario
AUTH_PASSWORD=tu_contraseña
# Secreto para firmar la cookie de sesión (recomendado en producción)
AUTH_SECRET=una_cadena_larga_y_aleatoria

# Base de datos Postgres (Neon / Vercel Postgres)
# En Vercel se agrega automáticamente al conectar la base desde Storage.
# Para desarrollo local, copiá la cadena de conexión desde el panel de Neon/Vercel.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
